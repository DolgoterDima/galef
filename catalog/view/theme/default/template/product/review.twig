{% if reviews %}
  {% for review in reviews %}
    <article class="review-item" data-review-id="{{ review.review_id }}">
      <div class="review-item__rating-col">
        <div class="review-item__stars" aria-label="Рейтинг {{ review.rating }} з 5">
          {% for i in 1..5 %}
            <svg class="review-item__star{% if review.rating < i %} review-item__star--empty{% endif %}" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 12.0533L12.9467 15L11.6267 9.4L16 5.61333L10.24 5.12L8 0L5.76 5.12L0 5.61333L4.37333 9.4L3.05333 15L8 12.0533Z" fill="currentColor"></path>
            </svg>
          {% endfor %}
        </div>
        <div class="review-item__date">{{ review.date_added }}</div>
      </div>

      <div class="review-item__content-col">
        <div class="review-item__header">
          <span class="review-item__author">{{ review.author }}</span>
        </div>
        <div class="review-item__text-block">
          <p class="review-item__text">{{ review.text }}</p>
        </div>
        {% if review.image %}
          <div class="review-item__gallery">
            <a href="{{ review.image }}" class="review-item__gallery-link js-review-image-popup" aria-label="Open review photo">
              <img src="{{ review.image }}" alt="Фото з відгуку" class="review-item__gallery-img">
            </a>
          </div>
        {% endif %}
        {% if review.replies %}
          <div class="review-item__replies">
            {% for reply in review.replies %}
              <div class="review-reply">
                <div class="review-reply__header">
                  <span class="review-reply__author">{{ reply.author }}</span>
                  <span class="review-reply__date">{{ reply.date_added }}</span>
                </div>
                <p class="review-reply__text">{{ reply.text }}</p>
              </div>
            {% endfor %}
          </div>
        {% endif %}
        {% if review_reply_allowed %}
        <button class="review-item__reply-btn js-review-reply-open" type="button" data-review-id="{{ review.review_id }}" data-review-author="{{ review.author }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
          </svg>
          Відповісти
        </button>
        {% endif %}
      </div>

      <div class="review-item__actions-col">
        <div class="review-item__reactions">
          <button class="review-item__reaction-btn" type="button" aria-label="Подобається">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
            </svg>
          </button>
          <button class="review-item__reaction-btn" type="button" aria-label="Не подобається">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10 15v4a3 3 0 0 0 3 3l4-9V2H5.72a2 2 0 0 0-2 1.7l-1.38 9a2 2 0 0 0 2 2.3zm7-13h3a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-3"></path>
            </svg>
          </button>
        </div>
      </div>
    </article>
  {% endfor %}

  <div class="reviews-block__pagination">
    <div class="reviews-block__pagination-links">{{ pagination }}</div>
    <div class="reviews-block__pagination-results">{{ results }}</div>
  </div>
{% else %}
  <div class="reviews-block__empty">{{ text_no_reviews }}</div>
{% endif %}
